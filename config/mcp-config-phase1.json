{
  "mcpServers": {
    "github-issue-fetcher": {
      "command": "node",
      "args": ["../skills/github-issue-fetcher/index.js"],
      "tools": ["*"],
      "env": {
        "GITHUB_TOKEN": "${GITHUB_TOKEN}"
      }
    },
    "code-similarity-finder": {
      "command": "node",
      "args": ["../skills/code-similarity-finder/index.js"],
      "tools": ["*"]
    },
    "similar-issue-finder": {
      "command": "node",
      "args": ["../skills/similar-issue-finder/index.js"],
      "tools": ["*"],
      "env": {
        "AI_ISSUE_KB_PATH": "${AI_ISSUE_KB_PATH}",
        "AI_ISSUE_SERVICE_URL": "${AI_ISSUE_SERVICE_URL}",
        "AI_ISSUE_SERVICE_API_KEY": "${AI_ISSUE_SERVICE_API_KEY}"
      }
    },
    "report-validator": {
      "command": "node",
      "args": ["../skills/report-validator/index.js"],
      "tools": ["*"]
    }
  }
}
